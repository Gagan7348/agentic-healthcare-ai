# Healthcare AI Backend Environment Variables
# Copy this file to .env and fill in your values

# Gemini AI Configuration
GEMINI_API_KEY='your_api_key_here'

# Application Settings
DEBUG=False
APP_NAME=Healthcare AI API
APP_VERSION=1.0.0

# Server Settings
API_HOST=0.0.0.0
API_PORT=8000

# Database (optional)
# SQLite example (default):
# DATABASE_URL=sqlite:///./healthcare_ai.db
# PostgreSQL example:
DATABASE_URL=postgresql://postgres:password@localhost:5432/healthcare_db

# Voice Settings
VOICE_ENABLED=True
VOICE_LANGUAGE=hi-IN

# ASHA Mode
ASHA_MODE_ENABLED=True

# CORS (comma-separated origins)
CORS_ORIGINS=*
